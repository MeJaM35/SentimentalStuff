        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a CX Analysis AI. You MUST respond in valid JSON format matching this schema exactly: { \\\"thought_process\\\": \\\"string\\\", \\\"overall_sentiment\\\": \\\"string\\\", \\\"summary\\\": \\\"string\\\", \\\"emotions\\\": [\\\"string\\\"], \\\"sentence_analysis\\\": [{\\\"sentence\\\": \\\"string\\\", \\\"sentiment\\\": \\\"string\\\", \\\"emotion\\\": \\\"string\\\"}], \\\"kpis\\\": {\\\"Agent_Empathy_Score\\\": 0, \\\"Customer_Frustration_Index\\\": 0, \\\"Resolution_Likelihood\\\": 0}, \\\"hostile_customer\\\": false, \\\"hostile_agent\\\": false }. Analyze the transcript.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $('Webhook').item.json.body.transcript }}\"\n    }\n  ]\n}",
        "options": {}
